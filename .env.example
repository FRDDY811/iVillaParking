# Server
PORT=3001
NODE_ENV=development # Options: development, production, stage.
DATABASE_URL="file:./dev.db"

# JWT
# Secret keys should be at least 32 characters long for better security.
JWT_SECRET=your-secret-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_EXPIRES_IN=15m # Short-lived for security
JWT_REFRESH_EXPIRES_IN=7d # Long-lived for better UX

# CORS
# Use "*" for development or specific URLs separated by comma for production
CORS_ORIGIN=http://localhost:5173

# Client
VITE_API_URL=http://localhost:3001/api
