{
  "name": "ivillaparking",
  "version": "1.0.0",
  "private": true,
  "description": "Parking Management System for residential community",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build:server": "npm run build --workspace=server",
    "build:client": "npm run build --workspace=client",
    "test": "npm test --workspace=server && npm test --workspace=client ",
    "test:server": "npm test --workspace=server",
    "test:client": "npm test --workspace=client",
    "db:migrate": "npm run db:migrate --workspace=server",
    "db:seed": "npm run db:seed --workspace=server",
    "db:reset": "npm run db:reset --workspace=server",
    "lint": "eslint .",
    "delint": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "overrides": {
    "esbuild": "0.25.10"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "eslint": "^9.39.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.3.0",
    "prettier": "^3.8.1",
    "typescript-eslint": "^8.56.1"
  }
}
